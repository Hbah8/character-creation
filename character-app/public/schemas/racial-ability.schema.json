{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/character-creation/schemas/racial-ability.schema.json",
  "title": "SWADE Racial Ability Handbook Entry",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "id", "handbookCategory", "name", "description", "type"],
      "properties": {
        "mode": { "const": "custom" }, "id": { "type": "string", "minLength": 1 }, "handbookCategory": { "const": "racialAbility" },
        "name": { "type": "string" }, "description": { "type": "string" }, "type": { "enum": ["positive", "negative"] }, "points": { "type": "number" },
        "pointCostOptions": { "type": "array", "items": { "type": "number" } }, "maxRepeat": { "oneOf": [{ "type": "number" }, { "const": "unlimited" }] },
        "parameterSchema": { "type": "array" }, "effects": { "type": "array" },
        "modifiers": { "type": "array", "items": { "$ref": "/character-creation/schemas/modifier.schema.json" } }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "id", "handbookCategory"],
      "properties": {
        "mode": { "const": "override" }, "id": { "type": "string", "minLength": 1 }, "handbookCategory": { "const": "racialAbility" },
        "name": { "type": "string" }, "description": { "type": "string" }, "type": { "enum": ["positive", "negative"] }, "points": { "type": "number" },
        "pointCostOptions": { "type": "array", "items": { "type": "number" } }, "maxRepeat": { "oneOf": [{ "type": "number" }, { "const": "unlimited" }] },
        "parameterSchema": { "type": "array" }, "effects": { "type": "array" },
        "modifiers": { "type": "array", "items": { "$ref": "/character-creation/schemas/modifier.schema.json" } }
      }
    }
  ]
}