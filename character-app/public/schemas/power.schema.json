{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/character-creation/schemas/power.schema.json",
  "title": "SWADE Power Handbook Entry",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "id", "handbookCategory", "name", "description", "arcaneBackground", "ppCost", "range", "duration"],
      "properties": {
        "mode": { "const": "custom" }, "id": { "type": "string", "minLength": 1 }, "handbookCategory": { "const": "power" },
        "name": { "type": "string" }, "description": { "type": "string" }, "arcaneBackground": { "type": "array", "items": { "enum": ["Magic", "Miracles", "Psionics", "SuperPowers", "WeirdScience"] } },
        "ppCost": { "type": "string" }, "range": { "type": "string" }, "duration": { "type": "string" }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "id", "handbookCategory"],
      "properties": {
        "mode": { "const": "override" }, "id": { "type": "string", "minLength": 1 }, "handbookCategory": { "const": "power" },
        "name": { "type": "string" }, "description": { "type": "string" }, "arcaneBackground": { "type": "array", "items": { "enum": ["Magic", "Miracles", "Psionics", "SuperPowers", "WeirdScience"] } },
        "ppCost": { "type": "string" }, "range": { "type": "string" }, "duration": { "type": "string" }
      }
    }
  ]
}