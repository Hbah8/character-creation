{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/character-creation/schemas/world.schema.json",
  "title": "SWADE World Builder World",
  "description": "Serialized world state used by the World Builder JSON export/import flow.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "summary",
    "entities",
    "relationships"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference",
      "description": "Optional schema hint for editors. The app ignores this field during import."
    },
    "schemaVersion": {
      "const": 1,
      "description": "World Builder schema version."
    },
    "name": {
      "type": "string",
      "description": "World name."
    },
    "summary": {
      "type": "string",
      "description": "Short world or campaign summary."
    },
    "entities": {
      "type": "array",
      "description": "World graph nodes. Entity ids must be unique.",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "relationships": {
      "type": "array",
      "description": "World graph edges. sourceId and targetId must reference existing entity ids.",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "settingRules": {
      "type": "object",
      "description": "SWADE setting rule overrides for this world. Absent fields fall back to SWADE defaults.",
      "additionalProperties": false,
      "properties": {
        "skillPointsBudget": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of skill points available during character creation. Default: 12."
        },
        "attributePointsBudget": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of attribute points available during character creation. Default: 5."
        },
        "racePointsBudget": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "World-specific racial ability points budget. Default: 2."
        }
      }
    },
    "races": {
      "type": "array",
      "description": "World-owned race templates and their stable racial ability references.",
      "items": {
        "$ref": "#/$defs/race"
      }
    },
    "worldHandbook": {
      "type": "array",
      "description": "World-level handbook custom entries and overrides.",
      "items": {
        "$ref": "/character-creation/schemas/handbook-entry.schema.json"
      }
    },
    "audio": {
      "$ref": "#/$defs/audio"
    }
  },
  "$defs": {
    "entityType": {
      "type": "string",
      "enum": [
        "location",
        "faction",
        "npc",
        "event",
        "item",
        "note"
      ]
    },
    "relationshipType": {
      "type": "string",
      "enum": [
        "controls",
        "belongs_to",
        "located_in",
        "ally",
        "enemy",
        "knows",
        "caused",
        "mentions",
        "custom"
      ]
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "race": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "abilities"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "size": {
          "type": "number"
        },
        "abilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/racialAbilityReference"
          }
        }
      }
    },
    "racialAbilityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "repeatCount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "assets",
        "tracks",
        "scenes",
        "presets"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/audioAsset"
          }
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/audioTrack"
          }
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/audioScene"
          }
        },
        "presets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/audioPreset"
          }
        }
      }
    },
    "audioAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "filename",
        "mediaType",
        "byteLength"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "filename": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string", "minLength": 1 },
        "byteLength": { "type": "number", "minimum": 0 },
        "durationSeconds": { "type": "number", "minimum": 0 },
        "checksum": { "type": "string" }
      }
    },
    "audioTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "assetId",
        "name",
        "loop",
        "defaultVolume"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "assetId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "loop": { "type": "boolean" },
        "defaultVolume": { "type": "number", "minimum": 0, "maximum": 1 },
        "muted": { "type": "boolean" },
        "presetId": { "type": "string" },
        "transition": { "enum": ["instant", "fade-short", "fade-medium", "fade-long"] }
      }
    },
    "audioPreset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "audioScene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "trackIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "trackIds": { "type": "array", "items": { "type": "string" } },
        "trackSettings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/audioSceneTrackSettings"
          }
        }
      }
    },
    "audioSceneTrackSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loop", "defaultVolume", "muted", "presetId", "transition"],
      "properties": {
        "loop": { "type": "boolean" },
        "defaultVolume": { "type": "number", "minimum": 0, "maximum": 1 },
        "muted": { "type": "boolean" },
        "presetId": { "type": ["string", "null"] },
        "transition": {
          "type": ["string", "null"],
          "enum": ["instant", "fade-short", "fade-medium", "fade-long", null]
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "summary",
        "description",
        "tags",
        "position"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/entityType"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "description": "Markdown notes for this entity."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "position": {
          "$ref": "#/$defs/position"
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceId",
        "targetId",
        "type",
        "label",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "targetId": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/relationshipType"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "description": "Markdown notes for this relationship."
        }
      }
    }
  }
}
