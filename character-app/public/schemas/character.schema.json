{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/character-creation/schemas/character.schema.json",
  "title": "SWADE Character Sheet",
  "description": "Serialized character state used by the Character Editor JSON export/import flow.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sheetTitle",
    "callsign",
    "name",
    "rank",
    "role",
    "fileNo",
    "portraitUrl",
    "isWildCard",
    "agility",
    "strength",
    "smarts",
    "spirit",
    "vigor",
    "skills",
    "edges",
    "hindrances",
    "weapons",
    "gear",
    "specialRules",
    "notes"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference",
      "description": "Optional schema hint for editors. The app ignores this field during import."
    },

    "sheetTitle": {
      "type": "string",
      "description": "Display title shown at the top of the character sheet (e.g. campaign or unit name)."
    },
    "callsign": {
      "type": "string",
      "description": "Character callsign or nickname."
    },
    "name": {
      "type": "string",
      "description": "Character full name."
    },
    "rank": {
      "type": "string",
      "enum": ["Novice", "Seasoned", "Veteran", "Heroic", "Legendary"],
      "description": "Canonical SWADE rank key. The UI translates it for display."
    },
    "role": {
      "type": "string",
      "description": "Character archetype or role in the group."
    },
    "fileNo": {
      "type": "string",
      "description": "Dossier or file number (free-form identifier)."
    },
    "portraitUrl": {
      "type": "string",
      "description": "Portrait image. May be an https URL or a base64 data-URI (data:image/…). Empty string means no portrait."
    },
    "isWildCard": {
      "type": "boolean",
      "description": "Whether this character is a SWADE Wild Card."
    },
    "arcaneBackground": {
      "type": "string",
      "enum": ["Magic", "Miracles", "Psionics", "SuperPowers", "WeirdScience"],
      "description": "Selected Arcane Background. Allowed only when the character has the Mystic Gift edge."
    },

    "agility": {
      "$ref": "#/$defs/dieName",
      "description": "Agility attribute die."
    },
    "strength": {
      "$ref": "#/$defs/dieName",
      "description": "Strength attribute die."
    },
    "smarts": {
      "$ref": "#/$defs/dieName",
      "description": "Smarts attribute die."
    },
    "spirit": {
      "$ref": "#/$defs/dieName",
      "description": "Spirit attribute die."
    },
    "vigor": {
      "$ref": "#/$defs/dieName",
      "description": "Vigor attribute die."
    },

    "combatModifiers": {
      "type": "array",
      "description": "Named permanent additions to calculated combat and resource parameters.",
      "items": {
        "$ref": "#/$defs/combatModifier"
      }
    },

    "skills": {
      "type": "array",
      "description": "List of character skills.",
      "items": {
        "$ref": "#/$defs/skill"
      }
    },
    "edges": {
      "type": "array",
      "description": "List of character edges.",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "hindrances": {
      "type": "array",
      "description": "List of character hindrances.",
      "items": {
        "$ref": "#/$defs/hindrance"
      }
    },
    "weapons": {
      "type": "array",
      "description": "List of weapons and equipment with combat stats.",
      "items": {
        "$ref": "#/$defs/weapon"
      }
    },
    "gear": {
      "type": "array",
      "description": "Free-form gear/inventory list. Each entry is a plain string.",
      "items": {
        "type": "string"
      }
    },
    "specialRules": {
      "type": "array",
      "description": "Custom special rules or abilities not covered by edges.",
      "items": {
        "$ref": "#/$defs/specialRule"
      }
    },

    "notes": {
      "type": "string",
      "description": "Freeform character notes."
    },

    "worldId": {
      "type": "string",
      "description": "Optional ID of the World this character belongs to. When set, setting rules (point budgets, etc.) are resolved from that world."
    },
    "raceId": {
      "type": "string",
      "description": "Optional ID of the selected world race."
    },
    "raceName": {
      "type": "string",
      "description": "Optional display name of the selected race."
    },
    "size": {
      "type": "number",
      "description": "Character-specific Size adjustment. The selected race Size is resolved separately."
    },
    "powers": {
      "type": "array",
      "description": "Arcane powers known by the character.",
      "items": {
        "$ref": "#/$defs/characterPower"
      }
    },

    "layout": {
      "$ref": "#/$defs/characterLayout",
      "description": "Column placement overrides for collections on the print sheet. Absent or null sections fall back to defaults."
    }
  },

  "$defs": {
    "dieName": {
      "type": "string",
      "enum": ["d4", "d6", "d8", "d10", "d12", ""],
      "description": "Standard SWADE die step. Empty string means the die has not been assigned yet."
    },

    "attributeKey": {
      "type": "string",
      "enum": ["agility", "strength", "smarts", "spirit", "vigor"],
      "description": "One of the five SWADE core attributes."
    },

    "hindranceSeverity": {
      "type": "string",
      "enum": ["minor", "major"],
      "description": "Hindrance severity. Minor = 1 point, Major = 2 points."
    },

    "columnSide": {
      "type": "string",
      "enum": ["left", "right"],
      "description": "Which column a collection is rendered in on the print sheet."
    },

    "skill": {
      "type": "object",
      "description": "A single character skill entry.",
      "additionalProperties": false,
      "required": ["id", "skillKey", "die"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this skill entry (UUID or similar)."
        },
        "skillKey": {
          "type": "string",
          "description": "Required stable canonical identity resolved from the system or character world skill handbook."
        },
        "die": {
          "$ref": "#/$defs/dieName",
          "description": "Current die rating for this skill."
        }
      }
    },

    "combatModifier": {
      "type": "object",
      "description": "A named additive permanent combat contribution. Derived totals are never stored here.",
      "additionalProperties": false,
      "required": ["id", "source", "name"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique modifier identifier."
        },
        "source": {
          "type": "string",
          "enum": ["edge", "hindrance", "equipment", "manual"],
          "description": "The non-racial rules source of this modifier. Racial effects are resolved from the selected race catalog."
        },
        "name": {
          "type": "string",
          "description": "Display name explaining the modifier."
        },
        "pace": {
          "type": "number"
        },
        "parry": {
          "type": "number"
        },
        "toughness": {
          "type": "number"
        },
        "armor": {
          "type": "number"
        },
        "runningDieSteps": {
          "type": "number"
        },
        "bennies": {
          "type": "number"
        },
        "maxWounds": {
          "type": "number"
        },
        "maxFatigue": {
          "type": "number"
        },
        "powerPoints": {
          "type": "number"
        }
      }
    },

    "edge": {
      "type": "object",
      "description": "A reference to a single edge in the system or character world handbook.",
      "additionalProperties": false,
      "required": ["id", "edgeId"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this selected edge row."
        },
        "edgeId": {
          "type": "string",
          "description": "Required stable canonical handbook identity, resolved from the system or character world edge catalog."
        }
      }
    },

    "hindrance": {
      "type": "object",
      "description": "A single character hindrance.",
      "additionalProperties": false,
      "required": ["id", "name", "severity", "description"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this hindrance entry."
        },
        "name": {
          "type": "string",
          "description": "Hindrance name."
        },
        "severity": {
          "$ref": "#/$defs/hindranceSeverity",
          "description": "Hindrance severity level."
        },
        "description": {
          "type": "string",
          "description": "Description of how this hindrance manifests for the character."
        }
      }
    },

    "weapon": {
      "type": "object",
      "description": "A single weapon or ranged/melee combat item.",
      "additionalProperties": false,
      "required": ["id", "name", "range", "damage", "ap", "rof", "magazine"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this weapon entry."
        },
        "name": {
          "type": "string",
          "description": "Weapon name."
        },
        "range": {
          "type": "string",
          "description": "Range bands (e.g. '12/24/48' for ranged, '-' for melee)."
        },
        "damage": {
          "type": "string",
          "description": "Damage dice expression (e.g. '2d6+1', 'Str+d8')."
        },
        "ap": {
          "type": "string",
          "description": "Armor Piercing value. Free-form string (e.g. '2', '-', '0')."
        },
        "rof": {
          "type": "string",
          "description": "Rate of Fire. Free-form string (e.g. '1', '3', '-')."
        },
        "magazine": {
          "type": "string",
          "description": "Magazine or clip size. Free-form string (e.g. '30', '-')."
        }
      }
    },

    "specialRule": {
      "type": "object",
      "description": "A custom special rule or ability.",
      "additionalProperties": false,
      "required": ["id", "name", "description"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this special rule entry."
        },
        "name": {
          "type": "string",
          "description": "Name of the special rule or ability."
        },
        "description": {
          "type": "string",
          "description": "Full description of the rule or ability."
        }
      }
    },

    "powerModifier": {
      "type": "object",
      "description": "A selected power modifier.",
      "additionalProperties": false,
      "required": ["id", "name", "ppCost"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ppCost": { "type": "string" }
      }
    },

    "characterPower": {
      "type": "object",
      "description": "A character arcane power and its selected modifiers.",
      "additionalProperties": false,
      "required": ["id", "name", "ppCost", "range", "duration", "description", "modifiers"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ppCost": { "type": "string" },
        "range": { "type": "string" },
        "duration": { "type": "string" },
        "description": { "type": "string" },
        "modifiers": {
          "type": "array",
          "items": { "$ref": "#/$defs/powerModifier" }
        }
      }
    },

    "characterLayout": {
      "type": "object",
      "description": "Per-collection column placement on the print sheet.",
      "additionalProperties": false,
      "required": ["weapons", "edges", "hindrances", "gear", "specialRules", "powers"],
      "properties": {
        "weapons": {
          "$ref": "#/$defs/columnSide"
        },
        "edges": {
          "$ref": "#/$defs/columnSide"
        },
        "hindrances": {
          "$ref": "#/$defs/columnSide"
        },
        "gear": {
          "$ref": "#/$defs/columnSide"
        },
        "specialRules": {
          "$ref": "#/$defs/columnSide"
        },
        "powers": {
          "$ref": "#/$defs/columnSide"
        }
      }
    }
  }
}
