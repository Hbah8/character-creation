{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/character-creation/schemas/edge.schema.json",
  "title": "SWADE Edge Handbook Entry",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "id", "handbookCategory", "name", "description", "type"],
      "properties": {
        "mode": { "const": "custom" },
        "id": { "type": "string", "minLength": 1 },
        "handbookCategory": { "const": "edge" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "type": { "enum": ["Background", "Combat", "Leadership", "Power", "Professional", "Social", "Weird", "WildCard"] },
        "wildCardOnly": { "type": "boolean" },
        "repeatable": { "type": "boolean" },
        "requirements": { "$ref": "#/$defs/requirements" },
        "modifiers": { "type": "array", "items": { "$ref": "/character-creation/schemas/modifier.schema.json" } }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "id", "handbookCategory"],
      "properties": {
        "mode": { "const": "override" },
        "id": { "type": "string", "minLength": 1 },
        "handbookCategory": { "const": "edge" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "type": { "enum": ["Background", "Combat", "Leadership", "Power", "Professional", "Social", "Weird", "WildCard"] },
        "wildCardOnly": { "type": "boolean" },
        "repeatable": { "type": "boolean" },
        "requirements": { "$ref": "#/$defs/requirements" },
        "modifiers": { "type": "array", "items": { "$ref": "/character-creation/schemas/modifier.schema.json" } }
      }
    }
  ],
  "$defs": {
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rank": { "enum": ["Novice", "Seasoned", "Veteran", "Heroic", "Legendary"] },
        "attributes": { "type": "object", "additionalProperties": { "enum": ["d4", "d6", "d8", "d10", "d12"] } },
        "skills": { "type": "object", "additionalProperties": { "enum": ["d4", "d6", "d8", "d10", "d12"] } },
        "edges": { "type": "array", "items": { "type": "string" } },
        "allOf": {
          "type": "array",
          "items": { "$ref": "#/$defs/requirement" }
        }
      }
    },
    "requirement": {
      "oneOf": [
        { "$ref": "#/$defs/condition" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["anyOf"],
          "properties": {
            "anyOf": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/condition" }
            }
          }
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "minimum"],
          "properties": {
            "type": { "const": "rank" },
            "minimum": { "enum": ["Novice", "Seasoned", "Veteran", "Heroic", "Legendary"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "attribute", "minimum"],
          "properties": {
            "type": { "const": "attribute" },
            "attribute": { "enum": ["agility", "smarts", "spirit", "strength", "vigor"] },
            "minimum": { "enum": ["d4", "d6", "d8", "d10", "d12"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "skill", "minimum"],
          "properties": {
            "type": { "const": "skill" },
            "skill": { "type": "string", "minLength": 1 },
            "minimum": { "enum": ["d4", "d6", "d8", "d10", "d12"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "minimum"],
          "properties": {
            "type": { "const": "arcaneSkill" },
            "minimum": { "enum": ["d4", "d6", "d8", "d10", "d12"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "edgeId"],
          "properties": {
            "type": { "const": "edge" },
            "edgeId": { "type": "string", "minLength": 1 },
            "arcaneBackground": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "hindranceId"],
          "properties": {
            "type": { "const": "hindrance" },
            "hindranceId": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "raceId"],
          "properties": {
            "type": { "const": "race" },
            "raceId": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "wildCard" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "text" },
            "text": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}