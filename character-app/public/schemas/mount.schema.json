{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/character-creation/schemas/mount.schema.json",
  "title": "SWADE Mount Handbook Entry",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "id", "handbookCategory", "name", "description", "category", "toughness"],
      "properties": {
        "mode": { "const": "custom" }, "id": { "type": "string", "minLength": 1 }, "handbookCategory": { "const": "mount" },
        "name": { "type": "string" }, "description": { "type": "string" }, "category": { "enum": ["animal", "vehicle"] }, "toughness": { "type": "number" },
        "pace": { "type": "number" }, "handling": { "type": "number" }, "cost": { "type": "number" }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "id", "handbookCategory"],
      "properties": {
        "mode": { "const": "override" }, "id": { "type": "string", "minLength": 1 }, "handbookCategory": { "const": "mount" },
        "name": { "type": "string" }, "description": { "type": "string" }, "category": { "enum": ["animal", "vehicle"] }, "toughness": { "type": "number" },
        "pace": { "type": "number" }, "handling": { "type": "number" }, "cost": { "type": "number" }
      }
    }
  ]
}